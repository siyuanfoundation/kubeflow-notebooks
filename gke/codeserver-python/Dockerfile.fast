#
# Fast Layer Dockerfile for Custom Kubeflow Code-Server Python Image with Google Antigravity
# Extends upstream ghcr.io/kubeflow/kubeflow/notebook-servers/codeserver-python:v1.11.0
#

ARG BASE_IMG=ghcr.io/kubeflow/kubeflow/notebook-servers/codeserver-python:v1.11.0
FROM $BASE_IMG

ARG TARGETARCH=amd64

# Extension versions (from Open VSX)
ARG ANTIGRAVITY_VERSION=1.3.0
ARG GEMINICODEASSIST_VERSION=2.100.0
ARG CLOUDCODE_VERSION=2.41.0

USER root

# Install Antigravity CLI (agy) into /usr/local/bin so it is available globally
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash -s -- -d /usr/local/bin \
 && chmod 755 /usr/local/bin/agy

USER $NB_UID

# Install additional Python requirements
COPY --chown=${NB_USER}:${NB_GID} requirements.txt /tmp/requirements.txt
RUN PIP_NO_CACHE_DIR=off python3 -m pip install -r /tmp/requirements.txt --quiet --no-cache-dir \
 && rm -f /tmp/requirements.txt

# Install additional VS Code extensions (Antigravity, Gemini Code Assist, Google Cloud Code)
# NOTE: XDG_DATA_HOME in Kubeflow codeserver is set to /tmp/data-${NB_USER} (non-PVC)
RUN code-server --install-extension "Google.google-antigravity@${ANTIGRAVITY_VERSION}" --force \
 && code-server --install-extension "Google.geminicodeassist@${GEMINICODEASSIST_VERSION}" --force \
 && code-server --install-extension "googlecloudtools.cloudcode@${CLOUDCODE_VERSION}" --force \
 && code-server --list-extensions --show-versions

# Pre-populate home with custom README and sync to $HOME_TMP for s6 01-copy-tmp-home
COPY --chown=${NB_USER}:${NB_GID} home/. ${HOME}/
RUN cp -p -r -T "${HOME}" "${HOME_TMP}" \
 && chmod -R g=u "${HOME_TMP}"
